# Copy to .env and adjust. Defaults target a local Homebrew PostgreSQL 17.
DATABASE_URL=postgres://localhost:5432/author_launch_engine
PORT=4000

# Content generation provider: "stub" (deterministic, no API key, default) or "anthropic".
AI_PROVIDER=stub

# Required only when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Drafts scoring below this confidence are escalated to a human instead of
# entering the normal approval queue (TBI: escalation control).
CONFIDENCE_ESCALATION_THRESHOLD=0.7

# Minimum drafts the agent must produce per week (REQ-001 acceptance criterion).
MIN_POSTS_PER_WEEK=3

# Directory listings scoring below this relevance are not recorded as
# opportunities (STORY-002 keyword analysis).
RELEVANCE_THRESHOLD=0.5

# Minimum opportunities to identify per month (REQ-002 acceptance criterion).
MIN_OPPORTUNITIES_PER_MONTH=5

# How well a listing has to fit the *author* — as opposed to the book — to be
# worth a human's attention (STORY-010). Its own floor because it is an
# independent reason to say yes: "Library Author Nights — evening talks where
# authors discuss their books" wants an author, not a lecture on the book's
# subject, and against the book's four theme labels it scores exactly 0.000.
# A lead qualifies on themes OR on expertise; requiring both would make this a
# filter that only ever narrows, and the story exists to widen reach.
EXPERTISE_THRESHOLD=0.5

# Press materials referencing fewer than this share of the book's themes are
# escalated regardless of how polished they are (REQ-003 acceptance criterion:
# "aligned with the book's themes"). Checked independently of confidence.
MIN_THEME_ALIGNMENT=0.5

# How many of the book's own words about a theme a draft has to carry before it
# counts as *arguing* that theme rather than name-checking it (STORY-006).
# A press release cannot quote a whole passage, so full marks is a handful of
# the right words. Naming a theme without arguing it scores 0.40 — deliberately
# below MIN_THEME_ALIGNMENT, so name-checking copy escalates.
THEME_MESSAGE_TERM_TARGET=8

# The same target for a social post (STORY-009). Lower because the format is
# smaller: a tweet has 280 characters and physically cannot carry eight of the
# book's words about a theme. The bar a given post actually faces is scaled from
# its own length between this floor and THEME_MESSAGE_TERM_TARGET, so judging is
# by the room the post took rather than by the platform's limit.
SOCIAL_MESSAGE_TERM_TARGET=3

# How close a social post has to sit to how the author actually writes, measured
# against their own previous posts (REQ-001: "sounds like the author"). Its own
# floor rather than a term inside confidence, so copy that argues the book's
# themes perfectly in a voice the author has never used still reaches a human.
# Nobody is held to a voice below MIN_POSTS_FOR_TRAIT prior posts of evidence.
MIN_VOICE_MATCH=0.5

# How many days ahead of a milestone the agent starts drafting its press kit
# (STORY-004: "Given a book anniversary is approaching"). The kit still waits for
# human approval — the lead time only decides when drafting begins.
MILESTONE_LEAD_TIME_DAYS=30

# Signing key for session tokens (STORY-064). The default in config.js exists so
# a fresh clone runs with no .env at all; it is published in this repository, so
# the server refuses to start with it when NODE_ENV=production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# How long a session lasts. Any ms/vercel duration string.
JWT_TTL=12h

# --- Background worker (STORY-065) ---
# How often a worker looks for due work.
WORKER_POLL_SECONDS=5

# How often each recurring sweep is due. This is what the idempotency key
# buckets on, so it is what "every N seconds" actually means — poll faster than
# this and the extra ticks find nothing new, which is the point.
JOB_SWEEP_SECONDS=300

# Attempts before a job stops being retried and starts waiting for a person.
JOB_MAX_ATTEMPTS=3

# First retry delay in seconds; doubles each attempt (30s, 60s, 120s…).
JOB_BACKOFF_SECONDS=30

# A job still marked 'running' after this long belongs to a worker that died.
# The reaper puts it back — with the attempt already counted, so a job that
# reliably kills its worker still reaches a human instead of looping.
JOB_STALE_SECONDS=300
