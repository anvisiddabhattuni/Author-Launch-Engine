{
  "name": "author-launch-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Author Launch Engine \u2014 STORY-001: Draft and Schedule Social Media Content (Content Drafting Agent)",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "db:reset": "npm run db:reset --workspace server",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "worker": "npm run worker --workspace server",
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "test": "npm run test --workspace server",
    "demo": "npm run demo --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
